    "desktop:service": "bun scripts/build-sidecar.ts",
    "desktop:dev": "bun scripts/desktop.ts dev",
    "desktop:build": "bun scripts/desktop.ts build",
    "desktop:info": "bun scripts/desktop.ts info"
  },
