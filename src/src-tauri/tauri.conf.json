{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DedsiWork",
  "version": "0.0.1",
  "identifier": "com.dedsi.work",
  "build": {
    "beforeDevCommand": "bun run desktop:service",
    "beforeBuildCommand": "bun run desktop:service",
    "frontendDist": "../desktop-ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DedsiWork",
        "width": 1360,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "create": false,
        "devtools": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/dedsiwork-service"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
